[
  {
    "name": "t:settings_schema.general.name",
    "settings": [
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary Color",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary Color",
        "default": "#666666"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent Color (CTAs, Links)",
        "default": "#0066cc"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background Color",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text Color",
        "default": "#333333"
      },
      {
        "type": "color",
        "id": "color_text_light",
        "label": "Light Text Color",
        "default": "#666666"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border Color",
        "default": "#eeeeee"
      },
      {
        "type": "header",
        "content": "Typography"
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading Font",
        "default": "shopify-sans-bold"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body Font",
        "default": "shopify-sans"
      },
      {
        "type": "header",
        "content": "Layout & Spacing"
      },
      {
        "type": "range",
        "id": "container_width",
        "label": "Container Width (px)",
        "min": 960,
        "max": 1400,
        "step": 20,
        "default": 1200
      },
      {
        "type": "range",
        "id": "spacing_multiplier",
        "label": "Spacing Scale (100% = normal)",
        "min": 80,
        "max": 150,
        "step": 5,
        "default": 100,
        "unit": "%"
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Border Radius (px)",
        "min": 0,
        "max": 16,
        "step": 1,
        "default": 4
      },
      {
        "type": "header",
        "content": "Logo & Branding"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo Width (px)",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 150
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon (192x192px recommended)"
      },
      {
        "type": "header",
        "content": "Header"
      },
      {
        "type": "select",
        "id": "header_style",
        "label": "Header Style",
        "options": [
          {
            "value": "minimal",
            "label": "Minimal (Logo + Search + Cart)"
          },
          {
            "value": "nav",
            "label": "With Navigation Menu"
          },
          {
            "value": "sticky",
            "label": "Sticky While Scrolling"
          }
        ],
        "default": "nav"
      },
      {
        "type": "checkbox",
        "id": "header_search_enabled",
        "label": "Show Search Bar",
        "default": true
      },
      {
        "type": "header",
        "content": "Announcement Bar"
      },
      {
        "type": "checkbox",
        "id": "announcement_enabled",
        "label": "Enable Announcement Bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Announcement Text",
        "default": "📦 Free shipping on orders over $50",
        "placeholder": "Enter your announcement"
      },
      {
        "type": "color",
        "id": "announcement_bg",
        "label": "Announcement Background",
        "default": "#000000"
      },
      {
        "type": "color",
        "id": "announcement_text_color",
        "label": "Announcement Text Color",
        "default": "#ffffff"
      },
      {
        "type": "header",
        "content": "Newsletter"
      },
      {
        "type": "text",
        "id": "newsletter_title",
        "label": "Newsletter Section Title",
        "default": "Subscribe for exclusive updates"
      },
      {
        "type": "textarea",
        "id": "newsletter_description",
        "label": "Newsletter Description",
        "default": "Be the first to know about new products and special offers."
      },
      {
        "type": "header",
        "content": "Footer"
      },
      {
        "type": "text",
        "id": "footer_copyright",
        "label": "Copyright Text",
        "default": "© 2026 Your Brand Name. All rights reserved.",
        "placeholder": "© [year] [your brand]"
      },
      {
        "type": "checkbox",
        "id": "footer_payment_icons",
        "label": "Show Payment Method Icons",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "footer_newsletter",
        "label": "Show Newsletter Signup in Footer",
        "default": true
      }
    ]
  },
  {
    "name": "Trust & Social Proof",
    "settings": [
      {
        "type": "header",
        "content": "Trust Badges"
      },
      {
        "type": "checkbox",
        "id": "trust_badges_enabled",
        "label": "Enable Trust Badges Section",
        "default": true
      }
    ]
  },
  {
    "name": "Homepage",
    "settings": [
      {
        "type": "header",
        "content": "Homepage Configuration"
      },
      {
        "type": "paragraph",
        "content": "Use Shopify Theme Editor to add and reorder sections on your homepage."
      }
    ]
  },
  {
    "name": "Product Page",
    "settings": [
      {
        "type": "header",
        "content": "Product Page Layout"
      },
      {
        "type": "checkbox",
        "id": "product_sticky_cart",
        "label": "Enable Sticky 'Add to Cart' on Mobile",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_zoom_enabled",
        "label": "Enable Image Zoom",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_reviews_enabled",
        "label": "Show Product Reviews",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "product_related_enabled",
        "label": "Show Related Products",
        "default": true
      }
    ]
  }
]
