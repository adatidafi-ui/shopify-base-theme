{% comment %}
  HERO SECTION
  - 4 layout variants
  - Full-width image or video background
  - Customizable headline, subheading, CTA
{% endcomment %}

<section style="background-color: var(--color-background); padding: 0;">
  {% case section.settings.layout %}
    {% when 'image-center' %}
      <div style="position: relative; min-height: 500px; display: flex; align-items: center; justify-content: center; background: linear-gradient(rgba(0,0,0,{{ section.settings.overlay_opacity }}), rgba(0,0,0,{{ section.settings.overlay_opacity }})), url('{{ section.settings.image | image_url: width: 1200 }}') center/cover no-repeat;">
        <div class="container" style="text-align: center; color: {{ section.settings.text_color }};">
          <h1 style="margin-bottom: var(--spacing-lg);">{{ section.settings.heading }}</h1>
          {% if section.settings.subheading %}
            <p style="font-size: 1.25rem; margin-bottom: var(--spacing-2xl); color: {{ section.settings.text_color }};">{{ section.settings.subheading }}</p>
          {% endif %}
          {% if section.settings.button_text and section.settings.button_link %}
            <a href="{{ section.settings.button_link }}" class="button button-primary">{{ section.settings.button_text }}</a>
          {% endif %}
        </div>
      </div>
    
    {% when 'image-left' %}
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 0; min-height: 500px;">
        <div style="background: url('{{ section.settings.image | image_url: width: 600 }}') center/cover no-repeat;"></div>
        <div style="display: flex; align-items: center; padding: var(--spacing-2xl); background-color: var(--color-background);">
          <div class="container">
            <h1 style="margin-bottom: var(--spacing-lg);">{{ section.settings.heading }}</h1>
            {% if section.settings.subheading %}
              <p style="font-size: 1.125rem; margin-bottom: var(--spacing-2xl);">{{ section.settings.subheading }}</p>
            {% endif %}
            {% if section.settings.button_text and section.settings.button_link %}
              <a href="{{ section.settings.button_link }}" class="button button-primary">{{ section.settings.button_text }}</a>
            {% endif %}
          </div>
        </div>
      </div>
    
    {% when 'text-only' %}
      <div style="background: linear-gradient(135deg, {{ section.settings.color_1 }} 0%, {{ section.settings.color_2 }} 100%); min-height: 300px; display: flex; align-items: center; justify-content: center; color: {{ section.settings.text_color }};">
        <div class="container" style="text-align: center;">
          <h1 style="margin-bottom: var(--spacing-lg);">{{ section.settings.heading }}</h1>
          {% if section.settings.subheading %}
            <p style="font-size: 1.25rem; margin-bottom: var(--spacing-2xl);">{{ section.settings.subheading }}</p>
          {% endif %}
          {% if section.settings.button_text and section.settings.button_link %}
            <a href="{{ section.settings.button_link }}" class="button button-primary">{{ section.settings.button_text }}</a>
          {% endif %}
        </div>
      </div>
  {% endcase %}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {"value": "image-center", "label": "Image with centered text"},
        {"value": "image-left", "label": "Image left, text right"},
        {"value": "text-only", "label": "Gradient background"}
      ],
      "default": "image-center"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome to our store"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Discover our premium collection."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop Now"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay opacity",
      "min": 0,
      "max": 0.8,
      "step": 0.1,
      "default": 0.3
    },
    {
      "type": "color",
      "id": "color_1",
      "label": "Gradient color 1",
      "default": "#0066cc"
    },
    {
      "type": "color",
      "id": "color_2",
      "label": "Gradient color 2",
      "default": "#00d4ff"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
