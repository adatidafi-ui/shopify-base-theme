{% comment %}
  TESTIMONIALS SECTION
  - Multiple layout variants
  - 3 different carousel/grid options
  - Customizable via blocks
{% endcomment %}

{% if section.settings.enabled %}
  <section style="padding: var(--spacing-2xl) var(--spacing-lg);">
    <div class="container">
      <h2 style="text-align: center; margin-bottom: var(--spacing-2xl);">{{ section.settings.title }}</h2>
      
      {% case section.settings.layout %}
        {% when 'grid-3' %}
          <div class="grid-3">
            {% for block in section.blocks %}
              <div class="testimonial-card">
                <div class="testimonial-card-stars">
                  {% for i in (1..5) %}
                    <span class="star is-filled">★</span>
                  {% endfor %}
                </div>
                <div class="testimonial-card-quote">"{{ block.settings.quote }}"</div>
                <div class="testimonial-card-author">
                  {% if block.settings.image %}
                    <div class="testimonial-card-avatar">
                      <img src="{{ block.settings.image | image_url: width: 40 }}" alt="{{ block.settings.author }}">
                    </div>
                  {% endif %}
                  <div>
                    <div class="testimonial-card-name">{{ block.settings.author }}</div>
                    {% if block.settings.role %}
                      <div class="testimonial-card-title">{{ block.settings.role }}</div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        
        {% when 'carousel' %}
          <div style="display: grid; grid-template-columns: 1fr; gap: var(--spacing-lg); overflow-x: auto;">
            {% for block in section.blocks %}
              <div class="testimonial-card" style="min-width: 100%;">
                <div class="testimonial-card-stars">
                  {% for i in (1..5) %}
                    <span class="star is-filled">★</span>
                  {% endfor %}
                </div>
                <div class="testimonial-card-quote">"{{ block.settings.quote }}"</div>
                <div class="testimonial-card-author">
                  {% if block.settings.image %}
                    <div class="testimonial-card-avatar">
                      <img src="{{ block.settings.image | image_url: width: 40 }}" alt="{{ block.settings.author }}">
                    </div>
                  {% endif %}
                  <div>
                    <div class="testimonial-card-name">{{ block.settings.author }}</div>
                    {% if block.settings.role %}
                      <div class="testimonial-card-title">{{ block.settings.role }}</div>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
      {% endcase %}
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable this section",
      "default": true
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "What Our Customers Are Saying"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {"value": "grid-3", "label": "3-column grid"},
        {"value": "carousel", "label": "Carousel (single slide)"}
      ],
      "default": "grid-3"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "This product has completely changed my life. Highly recommend!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Sarah Johnson"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Author role/title",
          "default": "Verified Customer"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author avatar"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {"type": "testimonial", "settings": {"quote": "Amazing quality and fast shipping!", "author": "John Smith", "role": "Verified Customer"}},
        {"type": "testimonial", "settings": {"quote": "Best purchase I've made this year.", "author": "Emma Davis", "role": "Verified Customer"}},
        {"type": "testimonial", "settings": {"quote": "Exceeded my expectations!", "author": "Michael Brown", "role": "Verified Customer"}}
      ]
    }
  ]
}
{% endschema %}
