{% comment %}
  HEADER SECTION
  - Logo, navigation, search, cart
  - Multiple layout options (minimal, nav, sticky)
  - Mobile menu
{% endcomment %}

<header class="header {% if section.settings.style == 'sticky' %}is-sticky{% endif %}">
  <div class="header-inner">
    <div class="header-logo">
      {% if settings.logo %}
        <a href="/" style="display: block;">
          <img src="{{ settings.logo | image_url: width: 200 }}" alt="{{ shop.name }}" style="height: 40px; width: auto;">
        </a>
      {% else %}
        <a href="/" style="font-weight: 700; font-size: 1.25rem;">{{ shop.name }}</a>
      {% endif %}
    </div>
    
    {% if section.settings.style != 'minimal' %}
      <nav class="header-nav" style="display: none;" data-header-nav>
        <a href="/collections/all">Shop</a>
        <a href="/pages/about">About</a>
        <a href="/pages/contact">Contact</a>
      </nav>
    {% endif %}
    
    <div class="header-nav">
      {% if settings.header_search_enabled %}
        <form class="header-search" method="get" action="/search">
          <input type="text" name="q" placeholder="Search" style="width: 150px;">
          <svg class="header-search-icon" width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="6" cy="6" r="5" stroke="currentColor" stroke-width="1.5"/>
            <path d="M10 10L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </form>
      {% endif %}
      
      <div class="header-cart" data-cart-toggle style="cursor: pointer;">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
          <path d="M3 4H4.5L6 14H14L15.5 4H17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          <circle cx="7" cy="15" r="1" fill="currentColor"/>
          <circle cx="13" cy="15" r="1" fill="currentColor"/>
        </svg>
        <span class="header-cart-count" style="display: none;" data-cart-count>0</span>
      </div>
      
      <button data-menu-toggle class="header-menu" style="display: none; background: none; border: none; cursor: pointer; padding: 0; font-size: 1.5rem;" aria-label="Menu">
        ☰
      </button>
    </div>
  </div>
</header>

<style>
  @media (max-width: 768px) {
    .header-nav[data-header-nav] {
      display: none !important;
    }
    
    .header-menu {
      display: block !important;
    }
    
    .header-search {
      display: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "Header style",
      "options": [
        {"value": "minimal", "label": "Minimal"},
        {"value": "nav", "label": "With Navigation"},
        {"value": "sticky", "label": "Sticky"}
      ],
      "default": "nav"
    }
  ]
}
{% endschema %}
