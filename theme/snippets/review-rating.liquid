{% comment %}
  REVIEW RATING SNIPPET
  - Displays star ratings and review count
  - Reusable component
{% endcomment %}

<div class="review-rating" style="display: flex; align-items: center; gap: var(--spacing-md);">
  {% if product.rating %}
    <div class="star-rating">
      {% for i in (1..5) %}
        <span class="star {% if i <= product.rating %}is-filled{% endif %}">★</span>
      {% endfor %}
    </div>
    <span style="color: var(--color-text-light);">
      {{ product.rating }} / 5 ({{ product.reviews_count }} {% if product.reviews_count == 1 %}review{% else %}reviews{% endif %})
    </span>
  {% else %}
    <span style="color: var(--color-text-light);">No reviews yet</span>
  {% endif %}
</div>
